{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "메인 창: 핵심 IPC, 이벤트 수신, 파일/폴더 선택 대화상자만 허용한다. 파일 읽기·쓰기는 Rust 명령이 검증 후 수행한다.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
